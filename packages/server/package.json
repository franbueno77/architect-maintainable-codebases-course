{
    "name": "@seeds/server",
    "version": "0.0.2",
    "dependencies": {
        "@seeds/models": "workspace:*",
        "cors": "^2.8.5",
        "express": "^5.1.0",
        "winston": "^3.17.0",
        "yaml": "^2.8.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.28.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/node": "^24.0.0",
        "@vitest/coverage-v8": "^3.2.3",
        "@vitest/ui": "^3.2.3",
        "concurrently": "^9.1.2",
        "eslint": "^9.28.0",
        "tsx": "^4.20.0",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.34.0",
        "vitest": "^3.2.3"
    },
    "module": "dist/index.js",
    "private": true,
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "check": "tsc --noEmit --skipLibCheck",
        "dev": "tsx --watch  src/index.ts",
        "lint": "eslint .",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:ui": "vitest --ui",
        "test:watch": "vitest"
    },
    "type": "module",
    "types": "dist/index.d.ts"
}
